# Node 24+. Next.js uses port 3000; NestJS uses port 3001.
PORT=3001
HOST=127.0.0.1
PAPER_TRADING=true
LIVE_TRADING_ENABLED=false
STRATEGY_ENABLED=false
INITIAL_BALANCE_USDC=1000
DATABASE_PATH=.data/momentify-sol-usdc.sqlite
# Put your real key in this backend-only URL. Never use NEXT_PUBLIC_.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
GECKOTERMINAL_API_URL=https://api.geckoterminal.com/api/v2
DEXSCREENER_API_URL=https://api.dexscreener.com
# Optional pin; empty discovers the highest-liquidity verified canonical pool.
SOL_USDC_POOL_ADDRESS=
SOL_MINT=So11111111111111111111111111111111111111112
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
MARKET_POLL_INTERVAL_MS=15000
MIN_LIQUIDITY_USD=100000
EMA_FAST_PERIOD=9
EMA_SLOW_PERIOD=21
POSITION_SIZE_PERCENT=10
MAX_DAILY_LOSS_PERCENT=5
STOP_LOSS_PERCENT=3
TAKE_PROFIT_PERCENT=6
PAPER_FEE_BPS=25
PAPER_SLIPPAGE_BPS=10
MAX_SLIPPAGE_BPS=100
# Optional for local use. Required when binding beyond localhost.
BACKEND_API_TOKEN=
